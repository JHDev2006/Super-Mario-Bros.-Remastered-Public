[sub_resource type="GDScript" id="GDScript_lpq2f"]
script/source = "extends Node2D

@export var nodes_to_delete: Array[Node] = []
@export var campaign := \"\"

func _ready() -> void:
	if Global.current_campaign != campaign:
		queue_free()
		return
	else:
		for i in nodes_to_delete:
			i.queue_free()
"

